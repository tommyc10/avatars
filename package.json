{
  "name": "avatars",
  "private": true,
  "type": "module",
  "description": "Animated bot avatars with living faces, starring a dragon in headphones. Built on bot-avatars from libraries.dev.",
  "scripts": {
    "dev": "vite demo --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build demo --config vite.config.ts --outDir ../dist --emptyOutDir",
    "test": "node --test tests/avatar.test.mjs",
    "shapes": "node scripts/gen-shapes.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
